+    SetInstallFocusRingOnFocus(true);
+    set_drag_controller(this);
+  }
+  void SetSelected(bool selected) {
+    if (selected_ != selected) {
+      selected_ = selected;
+      UpdateBackground();
+    }
+  }
+  void WriteDragDataForView(views::View*,
+                            const gfx::Point&,
+                            ui::OSExchangeData* data) override {
+    if (owner_) {
+      owner_->SetDragging(true);
+      data->SetString(owner_->DragPayload(id_));
+    }
+  }
+  void OnDragDone() override {
+    if (owner_) {
+      owner_->SetDragging(false);
+    }
+  }
+  int GetDragOperationsForView(views::View*, const gfx::Point&) override {
+    return ui::DragDropTypes::DRAG_MOVE;
+  }
+  bool CanStartDragForView(views::View*,
+                           const gfx::Point&,
+                           const gfx::Point&) override {
+    return true;
+  }
+  bool GetDropFormats(int* formats,
+                      std::set<ui::ClipboardFormatType>*) override {
+    *formats = ui::OSExchangeData::STRING;
+    return true;
+  }
+  bool CanDrop(const ui::OSExchangeData& data) override {
+    auto text = data.GetString();
+    return owner_ && text &&
+           (owner_->CanDropPage(*text, id_, 0) ||
+            owner_->CanDropPage(*text, id_, -1));
+  }
+  int OnDragUpdated(const ui::DropTargetEvent& event) override {
+    auto text = event.data().GetString();
+    return owner_ && text && owner_->CanDropPage(*text, id_, Zone(event))
+               ? ui::DragDropTypes::DRAG_MOVE
+               : ui::DragDropTypes::DRAG_NONE;
+  }
+  DropCallback GetDropCallback(const ui::DropTargetEvent& event) override {
+    auto text = event.data().GetString();
+    if (!owner_ || !text) {
+      return base::NullCallback();
+    }
+    return base::BindOnce(
+        [](base::WeakPtr<AeloWorkspaceHeader> owner, std::u16string payload,
+           std::string id, int zone, const ui::DropTargetEvent&,
+           ui::mojom::DragOperation& operation,
+           std::unique_ptr<ui::LayerTreeOwner>) {
+          operation = owner && owner->DropPage(payload, id, zone)
+                          ? ui::mojom::DragOperation::kMove
+                          : ui::mojom::DragOperation::kNone;
+        },
+        owner_, *text, id_, Zone(event));
+  }
+
+ protected:
+  void StateChanged(ButtonState old_state) override {
+    views::LabelButton::StateChanged(old_state);
+    UpdateBackground();
+  }
+ private:
+  void UpdateBackground() {
+    if (selected_) {
+      SetBackground(views::CreateSolidBackground(ui::kColorSysStateFocusHighlight));
