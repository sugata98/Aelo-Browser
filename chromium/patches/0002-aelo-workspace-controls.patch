+#include "ui/views/layout/flex_layout_view.h"
+
+class BrowserWindowInterface;
+namespace views {
+class Combobox;
+class MdTextButton;
+}  // namespace views
+namespace tabs {
+class VerticalTabStripStateController;
+}
+
+// Aelo workspace controls. Chromium groups own the live tabs and session state;
+// no WebContents or profile storage is moved into a parallel UI-only model.
+class AeloWorkspaceHeader : public views::FlexLayoutView,
+                            public TabStripModelObserver {
+  METADATA_HEADER(AeloWorkspaceHeader, views::FlexLayoutView)
+ public:
+  AeloWorkspaceHeader(BrowserWindowInterface* browser,
+                      tabs::VerticalTabStripStateController* state_controller);
+  ~AeloWorkspaceHeader() override;
+
+ private:
+  void ScheduleRefresh();
+  void Refresh();
+  void SelectSpace();
+  void CreateSpace();
+  void RenameSpace();
+  void OpenShortcut(const char* url);
+  void OnTabStripModelChanged(TabStripModel*,
+                              const TabStripModelChange&,
+                              const TabStripSelectionChange&) override;
+  void OnTabGroupChanged(const TabGroupChange&) override;
+  void OnTabGroupFocusChanged(std::optional<tab_groups::TabGroupId>,
+                              std::optional<tab_groups::TabGroupId>) override;
+  void OnTabStripModelDestroyed(TabStripModel*) override;
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Combobox> picker_ = nullptr;
+  raw_ptr<views::MdTextButton> rename_button_ = nullptr;
+  std::vector<tab_groups::TabGroupId> groups_;
+  bool refresh_pending_ = false;
+  base::CallbackListSubscription collapse_subscription_;
+  base::WeakPtrFactory<AeloWorkspaceHeader> weak_factory_{this};
+};
+#endif
