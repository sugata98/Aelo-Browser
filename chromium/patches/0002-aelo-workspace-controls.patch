+// Copyright 2026 Aelo contributors. BSD-style license.
+#ifndef CHROME_BROWSER_UI_TABS_AELO_TAB_IDENTITY_H_
+#define CHROME_BROWSER_UI_TABS_AELO_TAB_IDENTITY_H_
+#include <map>
+#include <string>
+
+#include "base/supports_user_data.h"
+#include "base/uuid.h"
+#include "content/public/browser/web_contents.h"
+namespace aelo {
+// UUIDs bridge the workspace to native session/reopen records. Never match a
+// page by URL, tab index or a session id that Chromium can reuse next launch.
+inline constexpr char kPageIdentityKey[] = "aelo.workspace_page_id";
+class TabIdentity : public base::SupportsUserData::Data {
+ public:
+  explicit TabIdentity(std::string id) : id_(std::move(id)) {}
+  static std::string Get(content::WebContents* contents) {
+    auto* data = static_cast<TabIdentity*>(contents->GetUserData(&key_));
+    if (!data) {
+      Set(contents, base::Uuid::GenerateRandomV4().AsLowercaseString());
+      data = static_cast<TabIdentity*>(contents->GetUserData(&key_));
+    }
+    return data->id_;
+  }
+  static void Set(content::WebContents* contents, const std::string& id) {
+    if (base::Uuid::ParseLowercase(id).is_valid()) {
+      contents->SetUserData(&key_, std::make_unique<TabIdentity>(id));
+    }
+  }
+  static void Restore(content::WebContents* contents,
+                      const std::map<std::string, std::string>& extra) {
+    auto it = extra.find(kPageIdentityKey);
+    if (it != extra.end()) {
+      Set(contents, it->second);
+    }
+  }
+
+ private:
+  inline static const char key_ = 0;
+  std::string id_;
+};
+}  // namespace aelo
+#endif
