+  SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+  SetInteriorMargin(gfx::Insets::VH(8, 8));
+  SetDefault(views::kMarginsKey, gfx::Insets::VH(3, 0));
+  auto* brand = AddChildView(std::make_unique<views::Label>(u"◉  Aelo"));
+  brand->SetSubpixelRenderingEnabled(false);
+  brand->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  brand->SetFontList(brand->font_list().Derive(7, gfx::Font::NORMAL,
+                                               gfx::Font::Weight::SEMIBOLD));
+  picker_ = AddChildView(std::make_unique<views::Combobox>());
+  picker_->SetTooltipTextAndAccessibleName(u"Space");
+  picker_->SetSizeToLargestLabel(false);
+  picker_->SetCallback(base::BindRepeating(&AeloWorkspaceHeader::SelectSpace,
+                                           base::Unretained(this)));
+  auto* actions = AddChildView(std::make_unique<views::FlexLayoutView>());
+  Button(actions, u"+ Space",
+         base::BindRepeating(&AeloWorkspaceHeader::Create,
+                             base::Unretained(this), aelo::Kind::kSpace));
+  Button(actions, u"+ Folder",
+         base::BindRepeating(&AeloWorkspaceHeader::Create,
+                             base::Unretained(this), aelo::Kind::kFolder));
+  Button(actions, u"+ Tab",
+         base::BindRepeating(&AeloWorkspaceHeader::NewPage,
+                             base::Unretained(this)));
+  name_ = AddChildView(std::make_unique<views::Textfield>());
+  name_->SetAccessibleName(u"Selected item name");
+  name_->SetPlaceholderText(u"Select a folder or page");
+  auto* edits = AddChildView(std::make_unique<views::FlexLayoutView>());
+  Button(edits, u"Rename",
+         base::BindRepeating(&AeloWorkspaceHeader::Rename,
+                             base::Unretained(this)));
+  pin_ = Button(edits, u"Pin",
+                base::BindRepeating(&AeloWorkspaceHeader::TogglePin,
+                                    base::Unretained(this)));
+  Button(edits, u"Remove",
+         base::BindRepeating(&AeloWorkspaceHeader::RemoveEmpty,
+                             base::Unretained(this)))
+      ->SetTooltipText(
+          u"Remove an empty folder, empty Space, or saved page after closing "
+          u"its live tab");
+  auto* move = AddChildView(std::make_unique<views::FlexLayoutView>());
+  move_picker_ = move->AddChildView(std::make_unique<views::Combobox>());
+  move_picker_->SetTooltipTextAndAccessibleName(
+      u"Move selected item to folder or Space");
+  move_picker_->SetSizeToLargestLabel(false);
+  // Only the width may flex in this horizontal row. An unbounded height
+  // here would consume the sidebar's remaining height before the tree.
+  move_picker_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                               views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  Button(move, u"Move",
+         base::BindRepeating(&AeloWorkspaceHeader::MoveSelected,
+                             base::Unretained(this)));
+  Button(move, u"↑",
+         base::BindRepeating(&AeloWorkspaceHeader::Reorder,
+                             base::Unretained(this), -1))
+      ->SetTooltipText(u"Move item up");
+  Button(move, u"↓",
+         base::BindRepeating(&AeloWorkspaceHeader::Reorder,
+                             base::Unretained(this), 1))
+      ->SetTooltipText(u"Move item down");
+  auto* scroll = AddChildView(std::make_unique<views::ScrollView>());
+  scroll->SetBackgroundColor(std::nullopt);
+  scroll->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  auto rows = std::make_unique<views::FlexLayoutView>();
+  rows->SetOrientation(views::LayoutOrientation::kVertical);
+  rows->SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+  rows_ = scroll->SetContents(std::move(rows));
