+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_AELO_WORKSPACE_HEADER_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_AELO_WORKSPACE_HEADER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
