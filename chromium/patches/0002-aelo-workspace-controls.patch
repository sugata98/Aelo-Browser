+bool AeloWorkspaceHeader::Load() {
+  if (!browser_) {
+    return false;
+  }
+  const auto& dict = browser_->GetProfile()->GetPrefs()->GetDict(kTreePref);
+  if (dict.empty()) {
+    tree_ = aelo::WorkspaceTree();
+    tree_.Add({NewId(), "", "Personal", aelo::Kind::kSpace});
+    tree_.Add({NewId(), "", "Focus", aelo::Kind::kSpace});
+    space_ = tree_.Children("").front();
+    return valid_ = true;
+  }
+  auto* nodes = dict.FindList("nodes");
+  if (dict.FindInt("version") != 1 || !nodes || nodes->size() > 10000) {
+    return valid_ = false;
+  }
+  std::vector<aelo::Node> parsed;
+  for (const auto& value : *nodes) {
+    if (!value.is_dict()) {
+      return valid_ = false;
+    }
+    const auto& n = value.GetDict();
+    auto* id = n.FindString("id");
+    auto* parent = n.FindString("parent");
+    auto* title = n.FindString("title");
+    auto* url = n.FindString("url");
+    auto kind = n.FindInt("kind");
+    if (!id || !parent || !title || !url || !kind || *kind < 0 || *kind > 2) {
+      return valid_ = false;
+    }
+    parsed.push_back({*id, *parent, *title, static_cast<aelo::Kind>(*kind),
+                      *url, n.FindBool("pinned").value_or(false),
+                      n.FindBool("expanded").value_or(true),
+                      n.FindBool("custom_title").value_or(false)});
+  }
+  if (!tree_.Load(std::move(parsed)) || tree_.Children("").empty()) {
+    return valid_ = false;
+  }
+  VLOG(1) << "AeloWorkspace load view=" << this << " collapsed="
+          << std::count_if(tree_.nodes().begin(), tree_.nodes().end(),
+              [](const aelo::Node& n) { return n.kind == aelo::Kind::kFolder && !n.expanded; });
+  if (auto* active = dict.FindString("active_space")) {
+    space_ = *active;
+  }
+  if (!tree_.Find(space_) || tree_.Find(space_)->kind != aelo::Kind::kSpace) {
+    space_ = tree_.Children("").front();
+  }
+  return valid_ = true;
+}
+void AeloWorkspaceHeader::Save() {
+  if (!browser_ || !valid_ || !tree_.Validate()) {
+    return;
+  }
+  base::DictValue dict;
+  dict.Set("version", 1);
+  dict.Set("active_space", space_);
+  base::ListValue nodes;
+  for (const auto& n : tree_.nodes()) {
+    base::DictValue value;
+    value.Set("id", n.id);
+    value.Set("parent", n.parent);
+    value.Set("title", n.title);
+    value.Set("kind", static_cast<int>(n.kind));
+    value.Set("url", n.url);
+    value.Set("pinned", n.pinned);
+    value.Set("expanded", n.expanded);
+    value.Set("custom_title", n.custom_title);
+    nodes.Append(std::move(value));
+  }
+  dict.Set("nodes", std::move(nodes));
+  auto* prefs = browser_->GetProfile()->GetPrefs();
+  if (prefs->GetDict(kTreePref) == dict) {
+    return;
+  }
+  if (!prefs->GetDict(kTreePref).empty()) {
+    prefs->SetDict(kBackupPref, prefs->GetDict(kTreePref).Clone());
+  }
+  VLOG(1) << "AeloWorkspace save view=" << this << " collapsed="
+          << std::count_if(tree_.nodes().begin(), tree_.nodes().end(),
+              [](const aelo::Node& n) { return n.kind == aelo::Kind::kFolder && !n.expanded; });
+  prefs->SetDict(kTreePref, std::move(dict));
+}
+void AeloWorkspaceHeader::ScheduleRefresh() {
+  if (refresh_pending_ || !browser_) {
+    return;
+  }
+  refresh_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&AeloWorkspaceHeader::Refresh,
+                                weak_factory_.GetWeakPtr()));
+}
+void AeloWorkspaceHeader::SyncTabs() {
+  auto* model = browser_->GetTabStripModel();
+  std::set<std::string> seen;
+  for (int i = 0; i < model->count(); ++i) {
+    auto* contents = model->GetWebContentsAt(i);
+    std::string id = aelo::TabIdentity::Get(contents);
+    // Duplicate-tab restore can copy extra data; the duplicate gets a new id.
+    if (!seen.insert(id).second) {
+      id = NewId();
+      aelo::TabIdentity::Set(contents, id);
+      seen.insert(id);
+    }
+    auto* node = tree_.Find(id);
+    if (!node) {
+      std::string parent = Destination();
+      // Adopt pre-existing groups once as independent Spaces. Never change or
+      // delete the native group itself; future tree edits do not depend on it.
+      if (auto group = model->GetTabGroupForTab(i)) {
+        parent = "adopted-" + group->ToString();
+        if (!tree_.Find(parent)) {
+          auto title = base::UTF16ToUTF8(model->group_model()
+                                             ->GetTabGroup(*group)
+                                             ->visual_data()
+                                             ->title());
+          tree_.Add({parent, "", title.empty() ? "Imported Space" : title,
+                     aelo::Kind::kSpace});
+        }
+      }
+      auto url = contents->GetVisibleURL().spec();
+      if (url.empty()) {
+        url = "chrome://newtab/";
+      }
+      tree_.Add({id, parent, "New Tab", aelo::Kind::kPage, url,
+                 model->IsTabPinned(i)});
+      node = tree_.Find(id);
+    }
+    if (!node || node->kind != aelo::Kind::kPage) {
+      continue;
+    }
+    auto url = contents->GetVisibleURL().spec();
+    if (!url.empty()) {
+      node->url = url;
+    }
+    auto title = base::UTF16ToUTF8(contents->GetTitle());
+    if (!title.empty() && !node->custom_title) {
+      node->title = title;
+    }
+    if (auto* session =
+            SessionServiceFactory::GetForProfile(browser_->GetProfile())) {
+      auto* helper = sessions::SessionTabHelper::FromWebContents(contents);
+      if (helper) {
+        session->AddTabExtraData(helper->window_id(), helper->session_id(),
+                                 aelo::kPageIdentityKey, id);
+      }
+    }
+  }
+}
+void AeloWorkspaceHeader::Refresh() {
+  refresh_pending_ = false;
+  if (!browser_) {
+    return;
+  }
+  if (dragging_ || picker_->IsMenuRunning() || move_picker_->IsMenuRunning() ||
+      (item_menu_runner_ && item_menu_runner_->IsRunning())) {
+    refresh_pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&AeloWorkspaceHeader::Refresh,
+                       weak_factory_.GetWeakPtr()),
+        base::Milliseconds(200));
+    return;
+  }
+  if (!Load()) {
+    for (const auto& [id, row] : row_views_) {
+      row->SetVisible(false);
+    }
+    if (!recovery_label_) {
+      recovery_label_ = rows_->AddChildView(std::make_unique<views::Label>(
+          u"Workspace needs recovery. Saved data has been preserved."));
+      recovery_label_->SetSubpixelRenderingEnabled(false);
+      recovery_label_->SetMultiLine(true);
+    }
+    recovery_label_->SetVisible(true);
+    CloseEditors();
+    return;
+  }
+  if (recovery_label_) {
+    recovery_label_->SetVisible(false);
+  }
+  visible_rows_.clear();
+  next_row_index_ = 0;
+  SyncTabs();
+  Save();
+  const auto new_spaces = tree_.Children("");
+  std::vector<std::u16string> space_titles;
+  std::vector<ui::SimpleComboboxModel::Item> spaces;
+  size_t selected_space = 0;
+  for (size_t i = 0; i < new_spaces.size(); ++i) {
+    auto title = base::UTF8ToUTF16(tree_.Find(new_spaces[i])->title);
+    space_titles.push_back(title);
+    spaces.emplace_back(title);
+    if (new_spaces[i] == space_) {
+      selected_space = i;
+    }
+  }
+  if (spaces_ != new_spaces || space_titles_ != space_titles) {
+    picker_->SetOwnedModel(
+        std::make_unique<ui::SimpleComboboxModel>(std::move(spaces)));
+    spaces_ = new_spaces;
+    space_titles_ = std::move(space_titles);
+  }
+  picker_->SetSelectedIndex(selected_space);
+  const auto* selection = tree_.Find(selected_);
+  if (!selection || tree_.SpaceOf(selected_) != space_) {
+    CloseEditors();
+    selected_ = space_;
+    selection = tree_.Find(selected_);
+  }
+  if (!name_->HasFocus()) {
+    name_->SetText(base::UTF8ToUTF16(selection->title));
+  }
+  std::string previous_destination;
+  if (auto i = move_picker_->GetSelectedIndex();
+      i && *i < destinations_.size()) {
+    previous_destination = destinations_[*i];
+  }
+  std::vector<std::string> destination_ids;
+  std::vector<std::u16string> destination_titles;
+  std::vector<ui::SimpleComboboxModel::Item> destinations;
+  for (const auto& n : tree_.nodes()) {
+    if (n.kind == aelo::Kind::kPage || !tree_.CanMove(selected_, n.id)) {
+      continue;
+    }
+    destination_ids.push_back(n.id);
+    std::string path = n.title;
+    for (auto p = n.parent; !p.empty();) {
+      const auto* parent = tree_.Find(p);
+      path = parent->title + " / " + path;
+      p = parent->parent;
+    }
+    auto title = base::UTF8ToUTF16(path);
+    destination_titles.push_back(title);
+    destinations.emplace_back(title);
+  }
+  if (destinations.empty()) {
+    destinations.emplace_back(u"No destination");
+    destination_titles.emplace_back(u"No destination");
+  }
+  if (destinations_ != destination_ids || destination_titles_ != destination_titles) {
+    move_picker_->SetOwnedModel(
+        std::make_unique<ui::SimpleComboboxModel>(std::move(destinations)));
+    destinations_ = std::move(destination_ids);
+    destination_titles_ = std::move(destination_titles);
+  }
+  auto previous = std::find(destinations_.begin(), destinations_.end(),
+                            previous_destination);
+  move_picker_->SetSelectedIndex(previous == destinations_.end()
+      ? 0 : static_cast<size_t>(previous - destinations_.begin()));
+  move_picker_->SetEnabled(!destinations_.empty());
+  auto* root = UpdateRow(space_, base::UTF8ToUTF16(tree_.Find(space_)->title));
+  root->SetProperty(views::kMarginsKey, gfx::Insets());
+  root->SetTooltipText(u"Space root — drop here to move out of folders");
+  RenderChildren(space_, 0);
+  FinishRows();
+}
+views::LabelButton* AeloWorkspaceHeader::UpdateRow(
+    const std::string& id, const std::u16string& text) {
+  auto found = row_views_.find(id);
+  views::LabelButton* row;
+  if (found == row_views_.end()) {
+    row = rows_->AddChildView(std::make_unique<WorkspaceRow>(
+        weak_factory_.GetWeakPtr(), id, text,
+        base::BindRepeating(&AeloWorkspaceHeader::Select,
+                            weak_factory_.GetWeakPtr(), id)));
+    row->set_context_menu_controller(this);
+    row_views_.emplace(id, row);
+    VLOG(1) << "AeloWorkspace row-create view=" << this << " id=" << id;
+  } else {
+    row = found->second;
+    if (row->GetText() != text) {
+      row->SetText(text);
+    }
+  }
+  static_cast<WorkspaceRow*>(row)->SetSelected(id == selected_);
+  visible_rows_.insert(id);
+  row->SetVisible(true);
+  rows_->ReorderChildView(row, next_row_index_++);
+  return row;
+}
+void AeloWorkspaceHeader::FinishRows() {
+  for (auto i = row_views_.begin(); i != row_views_.end();) {
+    if (!tree_.Find(i->first)) {
+      auto* row = i->second.get();
+      VLOG(1) << "AeloWorkspace row-remove view=" << this << " id=" << i->first;
+      i = row_views_.erase(i);
+      rows_->RemoveChildViewT(row);
+    } else {
+      i->second->SetVisible(visible_rows_.contains(i->first));
+      ++i;
+    }
+  }
+}
+
+void AeloWorkspaceHeader::RenderChildren(const std::string& parent, int depth) {
+  for (const auto& id : tree_.Children(parent)) {
+    const auto* n = tree_.Find(id);
+    std::u16string title = n->kind == aelo::Kind::kFolder
+                               ? (n->expanded ? u"▾  " : u"▸  ")
+                               : (n->pinned ? u"★  " : u"•  ");
+    if (id == selected_) {
+      title += u"› ";
+    }
+    title += base::UTF8ToUTF16(n->title);
+    auto* row = UpdateRow(id, title);
+    row->SetProperty(views::kMarginsKey,
+                     gfx::Insets::TLBR(0, std::min(depth * 14, 98), 0, 0));
+    row->SetTooltipText(base::UTF8ToUTF16(
+        n->kind == aelo::Kind::kPage ? n->url
+                                     : "Select to expand or collapse; + Folder "
+                                       "creates a nested folder"));
+    if (n->kind == aelo::Kind::kFolder && n->expanded) {
+      RenderChildren(id, depth + 1);
+    }
+  }
+}
+void AeloWorkspaceHeader::CloseEditors() {
+  rename_editor_->SetVisible(false);
+  move_editor_->SetVisible(false);
+}
+void AeloWorkspaceHeader::BeginEditing(bool move) {
+  const auto* n = tree_.Find(selected_);
+  if (!n) {
+    return;
+  }
+  CloseEditors();
+  if (move) {
+    move_editor_->SetVisible(true);
+    move_picker_->RequestFocus();
+  } else {
+    name_->SetText(base::UTF8ToUTF16(n->title));
+    rename_editor_->SetVisible(true);
+    name_->SelectAll(false);
+    name_->RequestFocus();
+  }
+}
+bool AeloWorkspaceHeader::HandleKeyEvent(views::Textfield* sender,
+                                         const ui::KeyEvent& event) {
+  if (sender != name_ || event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    Rename();
+  } else if (event.key_code() == ui::VKEY_ESCAPE) {
+    CloseEditors();
+  } else {
+    return false;
+  }
+  if (!rename_editor_->GetVisible()) {
+    auto row = row_views_.find(selected_);
+    if (row != row_views_.end() && row->second->GetVisible()) {
+      row->second->RequestFocus();
+    }
+  }
+  return true;
+}
+void AeloWorkspaceHeader::ShowActions() {
+  ShowItemMenu(GetBoundsInScreen().top_right(),
+               ui::mojom::MenuSourceType::kMouse);
+}
+void AeloWorkspaceHeader::ShowContextMenuForViewImpl(
+    views::View* source, const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  for (const auto& [id, row] : row_views_) {
+    if (row == source) {
+      CloseEditors();
+      selected_ = id;
+      Refresh();
+      ShowItemMenu(point, source_type);
+      return;
+    }
+  }
+}
+void AeloWorkspaceHeader::ShowItemMenu(
+    const gfx::Point& point, ui::mojom::MenuSourceType source_type) {
+  if (!valid_ || !tree_.Find(selected_) || !GetWidget()) {
+    return;
+  }
+  item_menu_runner_.reset();
+  item_menu_ = std::make_unique<ui::SimpleMenuModel>(this);
+  item_menu_->AddItem(kRename, u"Rename…");
+  item_menu_->AddItem(kMove, u"Move…");
+  item_menu_->AddItem(kPin, tree_.Find(selected_)->pinned ? u"Unpin" : u"Pin");
+  item_menu_->AddSeparator(ui::NORMAL_SEPARATOR);
+  item_menu_->AddItem(kMoveUp, u"Move Up");
+  item_menu_->AddItem(kMoveDown, u"Move Down");
+  item_menu_->AddSeparator(ui::NORMAL_SEPARATOR);
+  item_menu_->AddItem(kRemove, u"Forget closed page or empty container");
+  item_menu_runner_ = std::make_unique<views::MenuRunner>(
+      item_menu_.get(), views::MenuRunner::CONTEXT_MENU,
+      base::BindRepeating(&AeloWorkspaceHeader::ScheduleRefresh,
+                           weak_factory_.GetWeakPtr()));
+  item_menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                               views::MenuAnchorPosition::kTopLeft, source_type);
+}
+bool AeloWorkspaceHeader::SelectedPageIsLive() const {
+  bool live = false;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* candidate) {
+        if (candidate->GetProfile() == browser_->GetProfile()) {
+          auto* tabs = candidate->GetTabStripModel();
+          for (int i = 0; i < tabs->count(); ++i) {
+            live |= aelo::TabIdentity::Get(tabs->GetWebContentsAt(i)) == selected_;
+          }
+        }
+        return !live;
+      });
+  return live;
+}
+bool AeloWorkspaceHeader::IsCommandIdEnabled(int command) const {
+  const auto* n = tree_.Find(selected_);
+  if (!browser_ || !valid_ || !n) {
+    return false;
+  }
+  switch (command) {
+    case kRename: return true;
+    case kPin: return n->kind == aelo::Kind::kPage;
+    case kMove: return !destinations_.empty();
+    case kRemove:
+      return tree_.Children(n->id).empty() &&
+          (n->kind != aelo::Kind::kSpace || tree_.Children("").size() > 1) &&
+          (n->kind != aelo::Kind::kPage || !SelectedPageIsLive());
+    case kMoveUp:
+    case kMoveDown: {
+      const auto siblings = tree_.Children(n->parent);
+      const auto i = std::find(siblings.begin(), siblings.end(), selected_);
+      return i != siblings.end() && (command == kMoveUp
+          ? i != siblings.begin() : i + 1 != siblings.end());
+    }
+  }
+  return false;
+}
+void AeloWorkspaceHeader::ExecuteCommand(int command, int) {
+  if (!IsCommandIdEnabled(command)) {
+    return;
+  }
+  switch (command) {
+    case kRename:
+    case kMove:
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&AeloWorkspaceHeader::BeginEditing,
+                                    weak_factory_.GetWeakPtr(), command == kMove));
+      break;
+    case kPin: TogglePin(); break;
+    case kRemove: RemoveEmpty(); break;
+    case kMoveUp: Reorder(-1); break;
+    case kMoveDown: Reorder(1); break;
+  }
+}
+std::string AeloWorkspaceHeader::Destination() const {
+  const auto* n = tree_.Find(selected_);
+  if (!n || tree_.SpaceOf(selected_) != space_) {
+    return space_;
+  }
+  return n->kind == aelo::Kind::kPage ? n->parent : n->id;
+}
+void AeloWorkspaceHeader::Select(const std::string& id) {
+  if (!Load()) {
+    return;
+  }
+  const auto* n = tree_.Find(id);
+  if (!n) {
+    return;
+  }
+  CloseEditors();
+  VLOG(1) << "AeloWorkspace select view=" << this << " id=" << id
+          << " kind=" << static_cast<int>(n->kind)
+          << " expanded=" << n->expanded;
+  selected_ = id;
+  space_ = tree_.SpaceOf(id);
+  browser_->GetTabStripModel()->ExitFocusMode();
+  name_->SetText(base::UTF8ToUTF16(n->title));
+  if (n->kind == aelo::Kind::kFolder) {
+    tree_.Find(id)->expanded = !n->expanded;
+  }
+  if (n->kind == aelo::Kind::kPage) {
+    const auto url = n->url;
+    bool found = false;
+    GlobalBrowserCollection::GetInstance()->ForEach(
+        [&](BrowserWindowInterface* candidate) {
+          if (candidate->GetProfile() != browser_->GetProfile()) {
+            return true;
+          }
+          auto* tabs = candidate->GetTabStripModel();
+          for (int i = 0; i < tabs->count(); ++i) {
+            if (aelo::TabIdentity::Get(tabs->GetWebContentsAt(i)) == id) {
+              tabs->ExitFocusMode();
+              tabs->ActivateTabAt(i);
+              candidate->GetWindow()->Activate();
+              found = true;
+              return false;
+            }
+          }
+          return true;
+        });
+    if (!found) {
+      const GURL target(url);
+      // Restored metadata is not a license to launch local/executable schemes.
+      if (!target.SchemeIsHTTPOrHTTPS() && url != "chrome://newtab/" &&
+          url != "chrome://new-tab-page/" && url != "about:blank") {
+        return;
+      }
+      auto* contents = chrome::AddAndReturnTabAt(browser_, target, -1, true);
+      aelo::TabIdentity::Set(contents, id);
+    }
+  }
+  Save();
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::SelectSpace() {
+  auto index = picker_->GetSelectedIndex().value_or(0);
+  if (index >= spaces_.size() || !Load()) {
+    return;
+  }
+  const auto* chosen_space = tree_.Find(spaces_[index]);
+  if (!chosen_space || chosen_space->kind != aelo::Kind::kSpace) {
+    ScheduleRefresh();
+    return;
+  }
+  CloseEditors();
+  space_ = spaces_[index];
+  selected_ = space_;
+  browser_->GetTabStripModel()->ExitFocusMode();
+  name_->SetText(base::UTF8ToUTF16(tree_.Find(space_)->title));
+  Save();
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::Create(aelo::Kind kind) {
+  if (!Load()) {
+    return;
+  }
+  const auto parent = kind == aelo::Kind::kSpace ? "" : Destination();
+  const auto id = NewId();
+  if (!tree_.Add({id, parent,
+                  kind == aelo::Kind::kSpace ? "New Space" : "New Folder",
+                  kind})) {
+    return;
+  }
+  if (auto* p = tree_.Find(parent)) {
+    p->expanded = true;
+  }
+  selected_ = id;
+  space_ = tree_.SpaceOf(id);
+  browser_->GetTabStripModel()->ExitFocusMode();
+  name_->SetText(base::UTF8ToUTF16(tree_.Find(id)->title));
+  BeginEditing(false);
+  Save();
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::Rename() {
+  const auto text = base::UTF16ToUTF8(name_->GetText());
+  if (!Load() || text.find_first_not_of(" \t\r\n") == std::string::npos) {
+    return;
+  }
+  if (tree_.Rename(selected_, text)) {
+    CloseEditors();
+    Save();
+    ScheduleRefresh();
+  }
+}
+void AeloWorkspaceHeader::TogglePin() {
+  if (!Load()) {
+    return;
+  }
+  auto* n = tree_.Find(selected_);
+  if (!n || n->kind != aelo::Kind::kPage) {
+    return;
+  }
+  n->pinned = !n->pinned;
+  Save();
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::RemoveEmpty() {
+  if (!Load()) {
+    return;
+  }
+  const auto* n = tree_.Find(selected_);
+  if (!n || (n->kind == aelo::Kind::kSpace && tree_.Children("").size() == 1)) {
+    return;
+  }
+  if (n->kind == aelo::Kind::kPage) {
+    bool live = false;
+    GlobalBrowserCollection::GetInstance()->ForEach(
+        [&](BrowserWindowInterface* candidate) {
+          if (candidate->GetProfile() != browser_->GetProfile()) {
+            return true;
+          }
+          auto* tabs = candidate->GetTabStripModel();
+          for (int i = 0; i < tabs->count(); ++i) {
+            if (aelo::TabIdentity::Get(tabs->GetWebContentsAt(i)) ==
+                selected_) {
+              live = true;
+            }
+          }
+          return !live;
+        });
+    // Never bypass beforeunload by deleting a live browser-owned tab.
+    if (live) {
+      return;
+    }
+  }
+  const auto parent = n->parent;
+  if (!tree_.RemoveEmpty(selected_)) {
+    return;
+  }
+  if (space_ == selected_) {
+    space_ = tree_.Children("").front();
+  }
+  selected_ = parent.empty() ? space_ : parent;
+  Save();
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::MoveSelected() {
+  const auto index = move_picker_->GetSelectedIndex().value_or(0);
+  if (index >= destinations_.size() || !Load()) {
+    return;
+  }
+  const auto parent = destinations_[index];
+  if (!tree_.Move(selected_, parent, tree_.Children(parent).size())) {
+    return;
+  }
+  VLOG(1) << "AeloWorkspace move view=" << this << " id=" << selected_
+          << " parent=" << parent;
+  tree_.Find(parent)->expanded = true;
+  CloseEditors();
+  space_ = tree_.SpaceOf(selected_);
+  Save();
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::Reorder(int delta) {
+  if (!Load()) {
+    return;
+  }
+  const auto* n = tree_.Find(selected_);
+  if (!n) {
+    return;
+  }
+  auto siblings = tree_.Children(n->parent);
+  auto i = std::find(siblings.begin(), siblings.end(), selected_);
+  int position = static_cast<int>(i - siblings.begin()) + delta;
+  if (position < 0 || position >= static_cast<int>(siblings.size())) {
+    return;
+  }
+  if (tree_.Move(selected_, n->parent, position)) {
+    Save();
+    ScheduleRefresh();
+  }
+}
+void AeloWorkspaceHeader::NewPage() {
+  CloseEditors();
+  if (!Load()) {
+    return;
+  }
+  browser_->GetTabStripModel()->ExitFocusMode();
+  auto* contents =
+      chrome::AddAndReturnTabAt(browser_, GURL("chrome://newtab/"), -1, true);
+  const auto id = aelo::TabIdentity::Get(contents);
+  const auto parent = Destination();
+  tree_.Add({id, parent, "New Tab", aelo::Kind::kPage, "chrome://newtab/"});
+  // An explicit + Tab action reveals its destination, unlike session restore.
+  if (auto* destination = tree_.Find(parent)) {
+    destination->expanded = true;
+  }
+  selected_ = id;
+  Save();
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::SetDragging(bool dragging) {
+  VLOG(1) << "AeloWorkspace drag view=" << this << " active=" << dragging;
+  dragging_ = dragging;
+  if (!dragging) {
+    ScheduleRefresh();
+  }
+}
+std::u16string AeloWorkspaceHeader::DragPayload(const std::string& id) const {
+  return base::UTF8ToUTF16(nonce_ + ":" + id);
+}
+std::string AeloWorkspaceHeader::PayloadId(
+    const std::u16string& payload) const {
+  auto text = base::UTF16ToUTF8(payload);
+  auto prefix = nonce_ + ":";
+  return text.starts_with(prefix) ? text.substr(prefix.size()) : "";
+}
+std::pair<std::string, size_t> AeloWorkspaceHeader::DropDestination(
+    const std::string& target,
+    int zone) const {
+  const auto* n = tree_.Find(target);
+  if (!n) {
+    return {"", 0};
+  }
+  if (zone == 0 && n->kind != aelo::Kind::kPage) {
+    return {target, tree_.Children(target).size()};
+  }
+  auto siblings = tree_.Children(n->parent);
+  auto i = std::find(siblings.begin(), siblings.end(), target);
+  return {n->parent,
+          static_cast<size_t>(i - siblings.begin()) + (zone > 0 ? 1 : 0)};
+}
+bool AeloWorkspaceHeader::CanDropPage(const std::u16string& payload,
+                                      const std::string& target,
+                                      int zone) const {
+  auto id = PayloadId(payload);
+  if (!valid_ || id.empty() || id == target || !tree_.Find(target)) {
+    return false;
+  }
+  return tree_.CanMove(id, DropDestination(target, zone).first);
+}
+bool AeloWorkspaceHeader::DropPage(const std::u16string& payload,
+                                   const std::string& target,
+                                   int zone) {
+  if (!Load() || !CanDropPage(payload, target, zone)) {
+    VLOG(1) << "AeloWorkspace drop-rejected view=" << this << " target=" << target << " zone=" << zone;
+    return false;
+  }
+  const auto id = PayloadId(payload);
+  auto [parent, position] = DropDestination(target, zone);
+  auto siblings = tree_.Children(parent);
+  auto from = std::find(siblings.begin(), siblings.end(), id);
+  if (from != siblings.end() &&
+      static_cast<size_t>(from - siblings.begin()) < position) {
+    --position;
+  }
+  if (!tree_.Move(id, parent, position)) {
+    return false;
+  }
+  if (auto* p = tree_.Find(parent)) {
+    p->expanded = true;
+  }
+  selected_ = id;
+  space_ = tree_.SpaceOf(id);
+  Save();
+  ScheduleRefresh();
+  return true;
+}
+void AeloWorkspaceHeader::OnTabStripModelChanged(
+    TabStripModel*,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange&) {
+  if (change.type() == TabStripModelChange::kReplaced) {
+    aelo::TabIdentity::Set(
+        change.GetReplace()->new_contents,
+        aelo::TabIdentity::Get(change.GetReplace()->old_contents));
+  }
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::OnTabChangedAt(tabs::TabInterface*, TabChangeType) {
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::OnTabStripModelDestroyed(TabStripModel*) {
+  browser_ = nullptr;
+  weak_factory_.InvalidateWeakPtrs();
+}
+BEGIN_METADATA(AeloWorkspaceHeader)
+END_METADATA
