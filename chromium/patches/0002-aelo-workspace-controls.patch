@@ -0,0 +1,238 @@
+// Copyright 2026 Aelo contributors. BSD-style license.
+#include "chrome/browser/ui/views/tabs/vertical/aelo_workspace_header.h"
+
+#include <utility>
+
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/ui_features.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "components/tabs/public/tab_group.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/simple_combobox_model.h"
+#include "ui/views/controls/button/md_text_button.h"
+#include "ui/views/controls/combobox/combobox.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/view_class_properties.h"
+#include "url/gurl.h"
+
+AeloWorkspaceHeader::AeloWorkspaceHeader(
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller)
+    : browser_(browser) {
+  SetOrientation(views::LayoutOrientation::kVertical);
+  SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+  SetInteriorMargin(gfx::Insets::VH(12, 12));
+  SetDefault(views::kMarginsKey, gfx::Insets::VH(4, 0));
+
+  auto* brand = AddChildView(std::make_unique<views::Label>(u"◉  Aelo"));
+  // The vertical tab strip paints into a transparent composited layer. Use
+  // grayscale text, which does not sample nonexistent opaque RGB pixels.
+  brand->SetSubpixelRenderingEnabled(false);
+  brand->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  brand->SetFontList(brand->font_list().Derive(8, gfx::Font::NORMAL,
+                                               gfx::Font::Weight::SEMIBOLD));
+  auto* label = AddChildView(std::make_unique<views::Label>(u"SPACES"));
+  label->SetSubpixelRenderingEnabled(false);
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetFontList(label->font_list().DeriveWithSizeDelta(-2));
+
+  picker_ = AddChildView(std::make_unique<views::Combobox>());
+  picker_->SetTooltipTextAndAccessibleName(
+      u"Aelo Space — tabs share this profile");
+  picker_->SetSizeToLargestLabel(false);
+  picker_->SetCallback(base::BindRepeating(&AeloWorkspaceHeader::SelectSpace,
+                                           base::Unretained(this)));
+  auto* actions = AddChildView(std::make_unique<views::FlexLayoutView>());
+  actions->SetDefault(views::kMarginsKey, gfx::Insets::VH(0, 2));
+  auto* create = actions->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&AeloWorkspaceHeader::CreateSpace,
+                          base::Unretained(this)),
+      u"+ Space"));
+  create->SetTextSubpixelRenderingEnabled(false);
+  create->SetTooltipText(u"Create a Space in the current profile");
+  rename_button_ = actions->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&AeloWorkspaceHeader::RenameSpace,
+                          base::Unretained(this)),
+      u"Edit"));
+  rename_button_->SetTextSubpixelRenderingEnabled(false);
+  rename_button_->SetTooltipText(
+      u"Rename the selected Space or change its color");
+  const bool focus_enabled =
+      base::FeatureList::IsEnabled(features::kTabGroupsFocusing);
+  create->SetEnabled(focus_enabled &&
+                     browser_->GetTabStripModel()->SupportsTabGroups());
+  picker_->SetEnabled(create->GetEnabled());
+
+  auto* shortcuts = AddChildView(std::make_unique<views::FlexLayoutView>());
+  shortcuts->SetDefault(views::kMarginsKey, gfx::Insets::VH(0, 2));
+  for (const auto& shortcut :
+       {std::pair{u"Search", "https://www.google.com/"},
+        std::pair{u"Code", "https://github.com/"},
+        std::pair{u"Read", "https://en.wikipedia.org/"}}) {
+    auto* button =
+        shortcuts->AddChildView(std::make_unique<views::MdTextButton>(
+            base::BindRepeating(&AeloWorkspaceHeader::OpenShortcut,
+                                base::Unretained(this), shortcut.second),
+            shortcut.first));
+    button->SetTextSubpixelRenderingEnabled(false);
+    button->SetCustomPadding(gfx::Insets::VH(6, 8));
+    button->SetCornerRadius(12);
+    button->SetTooltipText(base::UTF8ToUTF16(shortcut.second));
+  }
+  browser_->GetTabStripModel()->AddObserver(this);
+  SetVisible(state_controller->GetCollapseState() ==
+             tabs::VerticalTabStripCollapseState::kExpanded);
+  collapse_subscription_ =
+      state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+          [](AeloWorkspaceHeader* view,
+             tabs::VerticalTabStripCollapseState state) {
+            view->SetVisible(state ==
+                             tabs::VerticalTabStripCollapseState::kExpanded);
+          },
+          base::Unretained(this)));
+  Refresh();
+}
+
+AeloWorkspaceHeader::~AeloWorkspaceHeader() = default;
+
+void AeloWorkspaceHeader::ScheduleRefresh() {
+  if (refresh_pending_ || !browser_) {
+    return;
+  }
+  refresh_pending_ = true;
+  // Group notifications can occur inside a TabStripModel mutation. Rebuild the
+  // picker afterwards, never mutate the model or destroy a menu in a
+  // notification.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&AeloWorkspaceHeader::Refresh,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void AeloWorkspaceHeader::Refresh() {
+  refresh_pending_ = false;
+  if (!browser_) {
+    return;
+  }
+  // Combobox's menu model references its owned model. Never replace it while
+  // a dropdown is open (a background tab/group event can also trigger refresh).
+  if (picker_->IsMenuRunning()) {
+    refresh_pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&AeloWorkspaceHeader::Refresh,
+                       weak_factory_.GetWeakPtr()),
+        base::Milliseconds(200));
+    return;
+  }
+  auto* model = browser_->GetTabStripModel();
+  auto* group_model = model->group_model();
+  groups_ = group_model ? group_model->ListTabGroups()
+                        : std::vector<tab_groups::TabGroupId>();
+  std::vector<ui::SimpleComboboxModel::Item> items;
+  items.emplace_back(u"All tabs");
+  size_t selected = 0;
+  for (size_t i = 0; i < groups_.size(); ++i) {
+    auto name = group_model->GetTabGroup(groups_[i])->visual_data()->title();
+    items.emplace_back(name.empty() ? u"Untitled Space" : name);
+    if (model->GetFocusedGroup() == groups_[i]) {
+      selected = i + 1;
+    }
+  }
+  picker_->SetOwnedModel(
+      std::make_unique<ui::SimpleComboboxModel>(std::move(items)));
+  picker_->SetSelectedIndex(selected);
+  rename_button_->SetEnabled(selected != 0);
+}
+
+void AeloWorkspaceHeader::SelectSpace() {
+  if (!browser_) {
+    return;
+  }
+  auto* model = browser_->GetTabStripModel();
+  const size_t index = picker_->GetSelectedIndex().value_or(0);
+  if (!index) {
+    model->ExitFocusMode();
+  } else if (index <= groups_.size() && model->group_model() &&
+             model->group_model()->ContainsTabGroup(groups_[index - 1])) {
+    model->EnterFocusMode(groups_[index - 1]);
+  }
+  ScheduleRefresh();
+}
+
+void AeloWorkspaceHeader::CreateSpace() {
+  if (!browser_) {
+    return;
+  }
+  auto* model = browser_->GetTabStripModel();
+  if (!model->SupportsTabGroups()) {
+    return;
+  }
+  const size_t count = model->group_model()->ListTabGroups().size();
+  // Only a new blank tab is grouped. Existing tabs, groups, pins and profiles
+  // are never reorganized implicitly by installing the Aelo UI.
+  auto* contents = chrome::AddAndReturnTabAt(browser_, GURL(), -1, true);
+  const int index = model->GetIndexOfWebContents(contents);
+  if (!model->ContainsIndex(index)) {
+    return;
+  }
+  const auto group = model->AddToNewGroup({index});
+  const std::u16string name =
+      count == 0   ? u"Personal"
+      : count == 1 ? u"Focus"
+                   : u"Space " + base::NumberToString16(count + 1);
+  model->ChangeTabGroupVisuals(group,
+                               tab_groups::TabGroupVisualData(
+                                   name, tab_groups::TabGroupColorId::kPurple),
+                               true);
+  model->EnterFocusMode(group);
+  ScheduleRefresh();
+}
+
+void AeloWorkspaceHeader::RenameSpace() {
+  if (!browser_) {
+    return;
+  }
+  auto* model = browser_->GetTabStripModel();
+  if (auto group = model->GetFocusedGroup()) {
+    model->OpenTabGroupEditor(*group);
+  }
+}
+
+void AeloWorkspaceHeader::OpenShortcut(const char* url) {
+  if (!browser_) {
+    return;
+  }
+  auto* model = browser_->GetTabStripModel();
+  chrome::AddAndReturnTabAt(browser_, GURL(url), -1, true,
+                            model->GetFocusedGroup());
+}
+
+void AeloWorkspaceHeader::OnTabStripModelChanged(
+    TabStripModel*,
+    const TabStripModelChange&,
+    const TabStripSelectionChange&) {
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::OnTabGroupChanged(const TabGroupChange&) {
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::OnTabGroupFocusChanged(
+    std::optional<tab_groups::TabGroupId>,
+    std::optional<tab_groups::TabGroupId>) {
+  ScheduleRefresh();
+}
+void AeloWorkspaceHeader::OnTabStripModelDestroyed(TabStripModel*) {
+  browser_ = nullptr;
+  weak_factory_.InvalidateWeakPtrs();
+}
+BEGIN_METADATA(AeloWorkspaceHeader)
+END_METADATA
